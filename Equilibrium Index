#include<iostream>
#include<vector>
using namespace std;
int toFindEquilibriumIndex(vector<int>& v,int n)
{
    for(int i=0;i<n;i++)
    {
        int left_sum=0;
        int right_sum=0;
        for(int j=0;j<i;j++)
        {
            left_sum+=v[j];
        }
        for(int j=i+1;j<n;j++)
        {
            right_sum+=v[j];
        }
        if(left_sum==right_sum)
        {
            return i;
        }
    }
    return -1;
}
int main()
{
    int n;
    cin>>n;
    vector<int>v(n);
    for(int i=0;i<n;i++)
    {
        cin>>v[i];
    }
    cout<<toFindEquilibriumIndex(v,n);
}

Method 2:Optimal
#include<iostream>
#include<vector>
using namespace std;
int equilibriumIndex(vector<int>& v,int n)
{
    int total_sum=0;
    for(int i=0;i<n;i++)
    {
        total_sum+=v[i];
    }
    int left_sum=0;
    for(int i=0;i<n;i++)
    {
        int right_sum=total_sum-left_sum-v[i];
        if(left_sum==right_sum)
        {
            return i;
        }
        left_sum+=v[i];
    }
    return -1;
}
int main()
{
    int n;
    cin>>n;
    vector<int>v(n);
    for(int i=0;i<n;i++)
    {
        cin>>v[i];
    }
    cout<<equilibriumIndex(v,n);
}

