#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
int main()
{
    int n1,n2;
    cin>>n1>>n2;
    vector<int>v1(n1);
    vector<int>v2(n2);
    vector<int>merged;
    for(int i=0;i<n1;i++)
    {
        cin>>v1[i];
    }
    for(int i=0;i<n2;i++)
    {
        cin>>v2[i];
    }
    merged.insert(merged.end(),v1.begin(),v1.end());
    merged.insert(merged.end(),v2.begin(),v2.end());
    if(merged.empty())
    {
        return 0;
    }
    sort(merged.begin(),merged.end());
    vector<int>unique;
    unique.reserve(merged.size());
    unique.push_back(merged[0]);
    for(int i=1;i<merged.size();i++)
    {
        if(merged[i]!=merged[i-1])
        {
            unique.push_back(merged[i]);
        }
    }
    for(auto it:unique)
    {
        cout<<it<<" ";
    }
}

