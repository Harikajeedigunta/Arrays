    for(int i=0;i<n1;i++) cin>>v1[i];
    for(int i=0;i<n2;i++) cin>>v2[i];
    vector<int>merged;
    int i=0,j=0;
    while(i<n1 && j<n2)
    {
        if(v1[i]<v2[j])
        {
            if(merged.empty() || merged.back()!=v1[i])
            {
                merged.push_back(v1[i]);
            }
            i++;
        }
        else if(v1[i]>v2[j])
        {
            if(merged.empty() || merged.back()!=v2[j])
            {
                merged.push_back(v2[j]);
            }
            j++;
        }
        else
        {
            if(merged.empty() || merged.back()!=v1[i])
            {
                merged.push_back(v1[i]);
            }
            i++;
            j++;
        }
    }
    while(i<n1)
    {
        if(merged.empty() || merged.back()!=v1[i])
