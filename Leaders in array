Method 1:Brute Force
#include<iostream>
#include<vector>
using namespace std;
int main()
{
    int n;
    cin>>n;
    vector<int>v(n);
    for(int i=0;i<n;i++)
    {
        cin>>v[i];
    }
    vector<int>nums;
    for(int i=0;i<n;i++)
    {
        bool isleader=true;
        for(int j=i+1;j<n;j++)
        {
            if(v[j]>=v[i])
            {
                isleader=false;
                break;
            }
        }
        if(isleader)
        {
            nums.push_back(v[i]);
        }
    }
    for(auto it:nums)
    {
        cout<<it<<" ";
    }
}

