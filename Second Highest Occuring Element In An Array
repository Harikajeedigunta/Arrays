Method 1:Using Hashing
#include<iostream>
#include<vector>
#include<climits>
using namespace std;
int main()
{
    int n;
    cin>>n;
    vector<int>arr(n);
    for(int i=0;i<n;i++)
    {
        cin>>arr[i];
    }
    int max_ele=arr[0];
    for(int i=0;i<n;i++)
    {
        if(arr[i]>max_ele)
        {
            max_ele=arr[i];
        }
    }
    int max_fre=0,second_max_fre=INT_MIN,min_ele=INT_MAX;
    vector<int>hash(max_ele+1,0);
    for(int i=0;i<n;i++)
    {
        hash[arr[i]]+=1;
    }
    for(int i=0;i<=max_ele;i++)
    {
        if(hash[i]>max_fre)
        {
            second_max_fre=max_fre;
            max_fre=hash[i];
        }
        else if(hash[i]>second_max_fre && hash[i]<max_fre)
        {
            second_max_fre=hash[i];
        }
    }
    for(int i=0;i<=max_ele;i++)
    {
        if(hash[i]==second_max_fre)
        {
            min_ele=min(min_ele,i);
        }
    }
    if(second_max_fre==0)
    {
        cout<<-1;
    }
    else 
    {
        cout<<min_ele;
    }
}

Method 2:Using Unordered_map
#include<iostream>
#include<vector>
#include<climits>
#include<unordered_map>
using namespace std;
int main()
{
    int n;
    cin>>n;
    vector<int>arr(n);
    for(int i=0;i<n;i++)
    {
        cin>>arr[i];
    }
    int max_fre=INT_MIN,sec_max_fre=INT_MIN,min_ele=INT_MAX;
    unordered_map<int,int>mp;
    for(auto& num:arr)
    {
        mp[num]+=1;
        max_fre=max(max_fre,mp[num]);
    }
    for(auto& pair:mp)
    {
        if(pair.second<max_fre)
        {
            sec_max_fre=max(sec_max_fre,pair.second);
        }
    }
    for(auto& pair:mp)
    {
        if(sec_max_fre==pair.second)
        {
            min_ele=min(min_ele,pair.first);
        }
    }
    if(sec_max_fre==INT_MIN)
    {
        cout<<-1;
    }
    else 
    {
        cout<<min_ele;
    }
}
