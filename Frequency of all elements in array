{
    int n;
    cin>>n;
    vector<int>v(n);
    for(int i=0;i<n;i++)
    {
        cin>>v[i];
    }
    int max_ele=INT_MIN;
    for(int i=0;i<n;i++)
    {
        if(v[i]>max_ele)
        {
            max_ele=v[i];
        }
    }
    int hash[max_ele+1]={0};
    for(int i=0;i<n;i++)
    {
        hash[v[i]]+=1;
    }
    for(int i=1;i<max_ele+1;i++)
    {
        cout<<i<<"-->"<<hash[i]<<endl;
    }
    return 0;
}

Method2:Uhing Hash_Map
#include<iostream>
#include<vector>
#include<map>
using namespace std;
int main()
{
    int n;
    cin>>n;
    vector<int>v(n);
    for(int i=0;i<n;i++)
    {
        cin>>v[i];
    }
    map<int,int>freq;
    for(auto num:v)
    {
        freq[num]+=1;
    }
    for(auto pair:freq)
    {
        cout<<pair.first<<"-->"<<pair.second<<endl;
    }
}

