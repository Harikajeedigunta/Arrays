#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
int main()
{
    int m,n;
    cin>>m>>n;
    vector<int>nums1(m+n);
    vector<int>nums2(n);
    for(int i=0;i<m;i++)
    {
        cin>>nums1[i];
    }
    for(int i=0;i<n;i++)
    {
        cin>>nums2[i];
    }
    for(int i=0;i<n;i++)
    {
        nums1[m+i]=nums2[i];
    }
    sort(nums1.begin(),nums1.end());
    for(auto it:nums1)
    {
        cout<<it<<" ";
    }
}

Method 2:Brute Force 2
#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
int main()
{
    int n,m;
    cin>>n>>m;
    vector<int>nums1(m+n);
    vector<int>nums2(n);
    for(int i=0;i<m;i++)
    {
        cin>>nums1[i];
    }
    for(int i=0;i<n;i++)
    {
        cin>>nums2[i];
    }
    int left=0;
    while(left<n)
    {
        nums1[m+left]=nums2[left];
        left++;
    }
    sort(nums1.begin(),nums1.end());
    for(auto it:nums1)
    {
        cout<<it<<" ";
    }
}

Method 3:Optimized using two pointer
#include<iostream>
#include<vector>
using namespace std;
int main()
{
    int m,n;
    cin>>m>>n;
    vector<int>nums1(m+n);
    vector<int>nums2(n);
    for(int i=0;i<m;i++)
    {
        cin>>nums1[i];
    }
    for(int i=0;i<n;i++)
    {
        cin>>nums2[i];
    }
    int i=m-1;
    int j=n-1;
    int k=m+n-1;
    while(i>=0 && j>=0)
    {
        if(nums1[i]>nums2[j])
        {
            nums1[k]=nums1[i];
            i--;
        }
        else 
        {
            nums1[k]=nums2[j];
            j--;
        }
        k--;
    }
    while(j>=0)
    {
        nums1[k]=nums2[j];
        j--;
        k--;
    }
    for(auto it:nums1)
    {
        cout<<it<<" ";
    }
}

