Method 1:Brute force
#include<iostream>
#include<vector>
using namespace std;
int main()
{
    int n,k;
    cin>>n>>k;
    vector<int>v(n);
    for(int i=0;i<n;i++)
    {
        cin>>v[i];
    }
    int i;
    for(i=0;i<=n-k;i+=k)
    {
        for(int j=i+k-1;j>=i;j--)
        {
            cout<<v[j]<<" ";
        }
    }
    if(i<n)
    {
        for(int m=n-1;m>=i;m--)
        {
            cout<<v[m]<<" ";
        }
    }
}

Method 2:
#include<iostream>
#include<vector>
using namespace std;
int main()
{
    int n,k;
    cin>>n>>k;
    vector<int>v(n);
    for(int i=0;i<n;i++)
    {
        cin>>v[i];
    }
    for(int i=0;i<n;i+=k)
    {
        int end=min(i+k-1,n-1);
        for(int j=end;j>=i;j--)
        {
            cout<<v[j]<<" ";
        }
    }
}

