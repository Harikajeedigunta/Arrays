Method 1:Brute Force
#include<iostream>
#include<vector>
using namespace std;
int main()
{
    int n;
    cin>>n;
    vector<int>v(n);
    for(int i=0;i<n;i++)
    {
        cin>>v[i];
    }
    int max_count=0;
    for(int i=0;i<n;i++)
    {
        int count=0;
        for(int j=i;j<n;j++)
        {
            if(v[j]==1)
            {
                count+=1;
                max_count=max(count,max_count);
            }
            else 
            {
                break;
            }
        }
    }
    cout<<max_count<<endl;
}

