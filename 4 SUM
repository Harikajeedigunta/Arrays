#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
int main()
{
    int n,target;
    cin>>n>>target;
    vector<int>v(n);
    for(int i=0;i<n;i++)
    {
        cin>>v[i];
    }
    vector<vector<int>>ans;
    for(int i=0;i<n;i++)
    {
        for(int j=i+1;j<n;j++)
        {
            for(int k=j+1;k<n;k++)
            {
                for(int l=k+1;l<n;l++)
                {
                    int sum=v[i]+v[j]+v[k]+v[l];
                    if(sum==target)
                    {
                        vector<int>temp={v[i],v[j],v[k],v[l]};
                        sort(temp.begin(),temp.end());
                        ans.push_back(temp);
                    }
                }
            }
        }
    }
    sort(ans.begin(),ans.end());
    ans.erase(unique(ans.begin(),ans.end()),ans.end());
    for(auto& quadralets:ans)
    {
        for(auto& num:quadralets)
        {
            cout<<num<<" ";
        }
        cout<<endl;
    }
}

Method 2:Optimized using two pointer
#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
int main()
{
    int n,target;
    cin>>n>>target;
    vector<int>v(n);
    for(int i=0;i<n;i++)
    {
        cin>>v[i];
    }
    sort(v.begin(),v.end());
    vector<vector<int>>ans;
    for(int i=0;i<n;i++)
    {
        if(i>0 && v[i]==v[i-1]) continue;
        for(int j=i+1;j<n;j++)
        {
            if(j>i+1 && v[j]==v[j-1]) continue;
            int left=j+1,right=n-1;
            // This is early break which makes code more optimal for interviews
            if((long long)v[i]+v[j]+v[left]+v[left+1]>target) break;
            if((long long)v[i]+v[j]+v[right]+v[right-1]<target) continue;
            while(left<right)
            {
                long long sum=v[i]+v[j]+v[left]+v[right];
                if(sum==target)
                {
                    ans.push_back({v[i],v[j],v[left],v[right]});
                    left++;
                    right--;
                    while(left<right && v[left]==v[left-1])
                    {
                        left++;
                    }
                    while(left<right && v[right]==v[right+1])
                    {
                        right--;
                    }
                }
                else if(sum<target)
                {
                    left++;
                }
                else 
                {
                    right--;
                }
            }
        }
    }
    for(auto& quadruplets:ans)
    {
        for(auto& num:quadruplets)
        {
            cout<<num<<" ";
        }
        cout<<endl;
    }
}

