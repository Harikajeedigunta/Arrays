#include<vector>
using namespace std;
int main()
{
    int n;
    cin>>n;
    vector<int>v(n);
    for(int i=0;i<n;i++)
    {
        cin>>v[i];
    }
    if(n==0)
    {
        return 0;
    }
    int i=0;
    while(i<v.size()-1)
    {
        if(v[i]==v[i+1])
        {
            v.erase(v.begin()+i);
        }
        else 
        {
            i++;
        }
    }
    for(int i=0;i<v.size();i++)
    {
        cout<<v[i]<<" ";
    }
}

