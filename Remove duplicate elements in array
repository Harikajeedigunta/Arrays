#include<iostream>
#include<vector>
using namespace std;
int main()
{
    int n;
    cin>>n;
    vector<int>v(n);
    for(int i=0;i<n;i++)
    {
        cin>>v[i];
    }
    if(n==0)
    {
        return 0;
    }
    int j=1;
    for(int i=1;i<n;i++)
    {
        if(v[i]!=v[i-1])
        {
            v[j]=v[i];
            j++;
        }
    }
    for(int i=0;i<j;i++)
    {
        cout<<v[i]<<" ";
    }
}

