#include<iostream>
#include<vector>
using namespace std;
int main()
{
    int n;
    cin>>n;
    vector<int>v(n);
    for(int i=0;i<n;i++)
    {
        cin>>v[i];
    }
    int count=0;
    int sum=0;
    for(int i=0;i<n;i++)
    {
        sum+=v[i];
    }
    int avg=sum/n;
    for(int i=0;i<n;i++)
    {
        if(v[i]>avg)
        {
            count+=1;
        }
    }
    cout<<count;
}

