Method 2: Using Maps
#include<iostream>
#include<vector>
#include<climits>
#include<unordered_map>
using namespace std;
int main()
{
    int n;
    cin>>n;
    vector<int>v(n);
    for(int i=0;i<n;i++)
    {
        cin>>v[i];
    }
    int max_fre=INT_MIN,min_fre=INT_MAX;
    unordered_map<int,int>mp;
    for(auto& num:v)
    {
        mp[num]+=1;
    }
    for(auto& num:mp)
    {
        if(num.second>max_fre)
        {
            max_fre=num.second;
        }
        if(num.second<min_fre)
        {
            min_fre=num.second;
        }
    }
    cout<<max_fre+min_fre;
}
